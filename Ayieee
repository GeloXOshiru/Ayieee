-- Load the Rayfield Library
local Rayfield = loadstring(game:HttpGet('sirius.menu'))()

-- Create the Main Window
local Window = Rayfield:CreateWindow({
   Name = "Roblox Pro Library",
   LoadingTitle = "Initializing UI...",
   LoadingSubtitle = "by YourName",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "RobloxUIConfig",
      FileName = "MainConfig"
   },
   Discord = {
      Enabled = false,
      Invite = "noinvite",
      RememberJoins = true
   },
   KeySystem = false, -- Set to true if you want a key system
})

-- Add a Tab with the Roblox Icon
-- Note: Use rbxassetid://6031068433 for a standard Roblox logo
local MainTab = Window:CreateTab("Home", 6031068433) 

-- Create a Section
local Section = MainTab:CreateSection("Features")

-- Create a Button
local Button = MainTab:CreateButton({
   Name = "Click Me",
   Callback = function()
       print("Button was clicked!")
   end,
})

-- Create a Toggle
local Toggle = MainTab:CreateToggle({
   Name = "Auto-Farm",
   CurrentValue = false,
   Flag = "Toggle1",
   Callback = function(Value)
       print("Auto-farm is now:", Value)
   end,
})
